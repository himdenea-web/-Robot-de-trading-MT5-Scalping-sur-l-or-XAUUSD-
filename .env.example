# Copy to .env and fill in. .env is ignored by git: never commit real keys.

# ---- MetaTrader 5
SYMBOL=XAUUSD
GB_MODE=alert                 # alert = notify only (decision support), trade = place orders
GB_REQUIRE_DEMO=true          # refuse to run on a real account
GB_MAX_SPREAD=0.50            # USD, skip setups when the live spread is wider

# ---- Funded-account rules (USD)
GB_RISK_PER_TRADE=90          # loss if the stop is hit
GB_MAX_TRADES_PER_DAY=2
GB_DAILY_LOSS_LIMIT=200
GB_FIRST_WEEK_LOSS_LIMIT=400
GB_WEEKLY_PROFIT_TARGET=600   # stop opening trades for the week once reached
GB_LOSS_BUFFER=15             # margin for slippage and gaps
GB_ACCOUNT_START=2026-11-23   # first day of the funded account (first-week rule)
GB_MAX_LOTS=1.0
GB_COUNT_ALL_ACCOUNT_PNL=true # limits count every trade on the account, not only the bot's

# ---- Strategy (opening range breakout)
GB_STRATEGY=orb
GB_ORB_SESSIONS=ny_comex      # comma list: london, ny_comex, ny_equity
GB_ORB_RANGE_MIN=60
GB_ORB_WINDOW_MIN=120
GB_ORB_STOP=mid               # mid or range
GB_ORB_TARGET_R=3.0
GB_ORB_TREND_FILTER=true

# ---- LLM committee (one provider for all agents)
GB_LLM_ENABLED=false
GB_LLM_PROVIDER=anthropic     # anthropic | openai | openai_compatible | your own registered name
GB_LLM_API_KEY=
GB_LLM_MODEL=                 # empty = provider default (anthropic: claude-opus-5-5); required for openai
GB_LLM_BASE_URL=              # openai_compatible only, e.g. https://openrouter.ai/api/v1
GB_LLM_FAIL_MODE=open         # open = trade the tested strategy if the LLM fails, closed = skip
GB_LLM_TIMEOUT=45
GB_LLM_MIN_APPROVALS=2        # analysts (of 3) that must approve before the chair decides
GB_LLM_USE_CHAIR=true

# ---- Telegram (optional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

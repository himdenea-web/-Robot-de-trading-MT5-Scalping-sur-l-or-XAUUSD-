# Copy to .env and fill in. .env is ignored by git: never commit real keys.

# ---- MetaTrader 5
# Leave GB_MT5_* empty to use a terminal that is already open and logged in. Filled in, the bot
# starts the terminal and logs it in by itself (needed for unattended restarts on a VPS).
GB_MT5_PATH=                  # e.g. C:\Program Files\FundedNext MT5 Terminal\terminal64.exe
GB_MT5_LOGIN=
GB_MT5_PASSWORD=
GB_MT5_SERVER=                # as shown in the MT5 login window
SYMBOL=XAUUSD
GB_MODE=alert                 # alert = notify only (decision support), trade = place orders
GB_REQUIRE_DEMO=true          # refuse to run on a real account
GB_MAX_SPREAD=0.50            # USD, skip setups when the live spread is wider

# ---- Funded-account rules (USD). Defaults: 5,000 two-phase account, no time limit.
# A limit set to 0 is switched off. Sizes shrink to the room left; below GB_MIN_RISK the trade is skipped.
GB_RISK_PER_TRADE=50          # loss if the stop is hit (50: about 40% pass in about 4 months if the edge holds)
GB_MAX_TRADES_PER_DAY=2
GB_DAILY_LOSS_LIMIT=200
GB_START_BALANCE=5000         # balance at the start of the phase
GB_ACCOUNT_START=             # first day of the phase (YYYY-MM-DD): counts the minimum trading days
GB_MIN_TRADING_DAYS=2         # FundedNext Stellar Lite: 2 days with a trade per phase
GB_MAX_TOTAL_LOSS=400         # static floor = start balance - 400 = 4,600
GB_PROFIT_TARGET=400          # phase 1: 400, phase 2: 200, funded: 0 (off)
GB_MAX_OPEN_RISK=150          # combined loss at the stops of all open and pending trades
GB_MIN_RISK=20
GB_LOSS_BUFFER=15             # margin for slippage and gaps
GB_FIRST_WEEK_LOSS_LIMIT=0    # optional extra rule
GB_WEEKLY_PROFIT_TARGET=0     # optional extra rule
GB_MAX_LOTS=1.0
GB_COMMISSION_RATE=0.000018   # per side, share of the trade value (Stellar Lite metals 0.0018%)
GB_LEVERAGE=15                # replaced live by the broker's real margin (Lite: 1:25 challenge, 1:15 funded)
GB_MAX_MARGIN_USE=0.5         # never use more than half the equity as margin
GB_COUNT_ALL_ACCOUNT_PNL=true # limits count every trade on the account, not only the bot's

# ---- Major announcements (gains within 5 minutes of a release may count only 40%)
GB_NEWS_SOURCE=forexfactory   # off | forexfactory | file | fixed:08:30,10:00,14:00 (New York times)
GB_NEWS_FILE=news.csv         # for file: columns time,title (New York time)
GB_NEWS_CURRENCIES=USD
GB_NEWS_BEFORE_MIN=6          # no new setups from 6 minutes before
GB_NEWS_AFTER_MIN=5           # to 5 minutes after a high-impact release
GB_NEWS_CLOSE_WINNERS=false   # true closes trades in profit before the window (backtest: worse)
GB_NEWS_PAUSE_PENDING=true    # hold waiting orders through the window, re-place them after (backtest: about free)

# ---- Strategy (opening range breakout)
GB_STRATEGY=orb
GB_ORB_SESSIONS=ny_comex      # comma list: london, ny_comex, ny_equity
GB_ORB_RANGE_MIN=60
GB_ORB_WINDOW_MIN=120
GB_ORB_STOP=mid               # mid or range
GB_ORB_TARGET_R=3.0
GB_ORB_TREND_FILTER=true

# ---- LLM committee (one provider for all agents)
GB_LLM_ENABLED=false
GB_LLM_PROVIDER=anthropic     # anthropic | openai | openai_compatible | your own registered name
GB_LLM_API_KEY=
GB_LLM_MODEL=                 # empty = provider default (anthropic: claude-opus-5-5); required for openai
GB_LLM_BASE_URL=              # openai_compatible only, e.g. https://openrouter.ai/api/v1
GB_LLM_FAIL_MODE=open         # open = trade the tested strategy if the LLM fails, closed = skip
GB_LLM_TIMEOUT=45
GB_LLM_MIN_APPROVALS=2        # analysts (of 3) that must approve before the chair decides
GB_LLM_USE_CHAIR=true

# ---- Telegram (optional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Unattended operation (see deploy/README.md)
GB_STATE_FILE=goldbot_state.json   # context of live orders, survives restarts
GB_LOG_FILE=logs/goldbot.log
GB_HEARTBEAT_NY=17:05         # daily Telegram status, New York time (empty = off)
GB_LOCK_PORT=47653            # refuses to start a second copy
